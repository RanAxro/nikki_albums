{
  "buildCommand": "node scripts/vercel/build_official_website.js && node scripts/vercel/copy_static_api.js",
  "outputDirectory": "build_official_website",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/:prefix*/guide",
      "destination": "/:prefix*/guide.html"
    },
    {
      "source": "/:prefix*/download",
      "destination": "/:prefix*/download.html"
    }
  ]
}
